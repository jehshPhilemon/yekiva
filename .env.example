# Copy to server/.env (never committed). The key stays on the server side.
META_API_KEY=
# Simple token shared with the app (limits abuse, does not replace real authentication)
APP_TOKEN=
PORT=8787
# Public URL of THIS Yekiva server, baked into the app at build time
# (tools/build-config.mjs). The learner never types a URL.
# Example: YEKIVA_SERVER_URL=https://yekiva-serveur.exemple
YEKIVA_SERVER_URL=
# Natural voice (runtime, per request): needs `pip install piper-tts` once on the server.
# Optional overrides: YEKIVA_VOICES_DIR=/var/cache/yekiva-voices
#   YEKIVA_VOICES='{"ln":"/path/to/lingala.onnx"}'  (per-language .onnx path or voice name)
