# Copy to server/.env (never committed). The key stays on the server side.
META_API_KEY=
# App access gate (prototype): exact match, or any valid YKV key (see docs/APP_KEYS.md).
# Empty = open server (dev only). Mint keys offline: node tools/make-key.mjs
APP_TOKEN=
PORT=8787
# Public URL of THIS Yekiva server, baked into the app at build time
# (tools/build-config.mjs). The learner never types a URL.
# Example: YEKIVA_SERVER_URL=https://yekiva-serveur.exemple
YEKIVA_SERVER_URL=
# Natural Meta voice is REQUIRED by the learning experience. Use the hosted API;
# the caller-side MMS key is optional only if that API allows keyless access.
YEKIVA_MMS_URL=https://api.jehshphilemon.com
# Do not put an MMS key in the APK. If the API requires one, provide it only to
# the Yekiva server via its process environment or system secret file.
# YEKIVA_MMS_KEY=
# Optional path override: YEKIVA_MMS_KEY_FILE=/etc/tts-api.env
# Optional format: YEKIVA_MMS_FORMAT=opus (opus|mp3|wav upstream; app receives MP3)
# If the key file is absent, self-host Meta MMS locally: see docs/TEST_TERMUX.md.
# Optional local MMS micro-service: YEKIVA_VOICE_URL=http://127.0.0.1:5001
# Optional: YEKIVA_MP3_QUALITY=6 (lame -q:a, lower = heavier but clearer)
